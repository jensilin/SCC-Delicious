# Frontend environment variables — names and placeholder values only.
#
# Vite inlines these into the browser bundle at build time, so anything placed here is
# published, not configured. Only non-sensitive values belong in this file. No Supabase
# project URL and no Supabase API key, publishable or otherwise.

VITE_API_BASE_URL="http://localhost:3000/api/v1"

# In production this is the deployed API with the same /api/v1 suffix, set in the Vercel project
# rather than in a file:
#
#   VITE_API_BASE_URL="https://scc-delicious-api.vercel.app/api/v1"
#
# It is read at build time, not at run time, so changing it in Vercel requires a redeploy to take
# effect. No trailing slash: every path in the client is written to follow one directly.
