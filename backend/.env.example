# Backend environment variables — names and placeholder values only.
# Copy to .env and fill in real values. Never commit .env.
#
# Supabase API keys are deliberately absent. This application reaches Supabase only as
# PostgreSQL through Prisma; no Supabase client library and no project API key is used on
# either side. See ARCHITECTURE.md constraint 6.

# Supabase PostgreSQL, connection pooler in transaction mode. Used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase PostgreSQL, direct connection. Used by Prisma migrations only.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# Local PostgreSQL used only by the test suite, which resets data destructively. It must be a
# throwaway database on this machine and never Supabase; tests/setup.js refuses any other host.
# Provision it with:
#   docker run -d --name scc-delicious-test-db -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=scc_delicious_test -p 127.0.0.1:5433:5432 postgres:16
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/scc_delicious_test"

# Token signing. These must be two different values: a shared secret would let a token issued
# for one purpose be presented for the other.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

BCRYPT_COST="12"

PORT="3000"
NODE_ENV="development"

# The one origin the browser application is served from. A wildcard is not permitted alongside
# credentials, and the refresh cookie requires credentials, so this names exactly one origin:
# scheme, host and port, with no trailing slash and no path.
CORS_ORIGIN="http://localhost:5173"

# --- Production (Vercel) --------------------------------------------------------------------
#
# The same variables, set in the Vercel project rather than in a file: there is no .env on a
# deployment. Only the three below take a different kind of value than they do above.
#
#   CORS_ORIGIN   The deployed frontend origin, e.g. https://scc-delicious.vercel.app — one
#                 origin, no trailing slash. A preview deployment has a different hostname, so a
#                 Preview-scoped value is needed to exercise one from the browser.
#   NODE_ENV      Vercel sets this to "production" itself. It is what turns on Secure and
#                 SameSite=None for the refresh cookie, which a cross-site deployment requires.
#   DIRECT_URL    Still needed, because `prisma generate` runs during the Vercel build and
#                 prisma.config.mjs reads it. The application never uses it at runtime.
#
# PORT is unused on Vercel: the platform invokes the exported app rather than a listening server.
# TEST_DATABASE_URL is local-only and must not be set on a deployment.
