# Backend environment variables — names and placeholder values only.
# Copy to .env and fill in real values. Never commit .env.
#
# Supabase API keys are deliberately absent. This application reaches Supabase only as
# PostgreSQL through Prisma; no Supabase client library and no project API key is used on
# either side. See ARCHITECTURE.md constraint 6.

# Supabase PostgreSQL, connection pooler in transaction mode. Used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase PostgreSQL, direct connection. Used by Prisma migrations only.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# Local PostgreSQL used only by the test suite, which resets data destructively. It must be a
# throwaway database on this machine and never Supabase; tests/setup.js refuses any other host.
# Provision it with:
#   docker run -d --name scc-delicious-test-db -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=scc_delicious_test -p 127.0.0.1:5433:5432 postgres:16
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/scc_delicious_test"

# Token signing. These must be two different values: a shared secret would let a token issued
# for one purpose be presented for the other.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

BCRYPT_COST="12"

PORT="3000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
